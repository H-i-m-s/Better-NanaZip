---
import Layout from "../layouts/Layout.astro";
import PageSection from "../components/PageSection/PageSection.astro";
import ThemedLocalPicture from "../components/ThemedLocalPicture/ThemedLocalPicture.astro";
import Tree from "../components/Tree/Tree.astro";

import '../assets/styles/pages/index.css';

import heroImageDark from "../assets/images/MainWindowDarkMode.png";
import heroImageLight from "../assets/images/MainWindowLightMode.png";

import contextMenuDark from "../assets/images/ContextMenuDark.png";
import contextMenuLight from "../assets/images/ContextMenuLight.png";

import ArchiveFile from "../assets/images/ArchiveFile.svg";

import RightArrow from '@fluentui/svg-icons/icons/arrow_right_32_regular.svg';
import FileIcon from '@fluentui/svg-icons/icons/document_20_regular.svg';
import FolderIcon from '@fluentui/svg-icons/icons/folder_20_regular.svg';
import ShieldIcon from '@fluentui/svg-icons/icons/shield_20_regular.svg';
import LockIcon from '@fluentui/svg-icons/icons/lock_closed_20_regular.svg';
import BoxIcon from '@fluentui/svg-icons/icons/archive_20_regular.svg';
import CheckmarkIcon from '@fluentui/svg-icons/icons/checkmark_20_regular.svg';
---

<Layout description="NanaZip 定制版主页">
	<main id="main">
		<PageSection header="NanaZip 定制版">
			<Fragment slot="description">
				<p class="subtitle">
					面向现代 Windows 体验的开源压缩工具，基于 7-Zip 26.02 内核，
					在本仓库中进行了深度定制：现代化界面、密码解决方案与交互优化。
				</p>
				<p>
					<a class="btn btn-accent" href="/downloads">立即下载</a>
					<a class="btn" href="https://github.com/H-i-m-s/Better-NanaZip">
						查看 GitHub 仓库
					</a>
				</p>
			</Fragment>
			<ThemedLocalPicture
				lightSrc={heroImageLight}
				darkSrc={heroImageDark}
				alt=""
				loading="eager"
				fetchPriority="high"
			/>
		</PageSection>

		<PageSection header="密码解决方案">
			<Fragment slot="description">
				<p class="subtitle">
					本定制版的核心增强：围绕压缩包密码处理提供一整套工具，
					解压过程全自动匹配密码，减少人工干预。
				</p>
			</Fragment>

			<div class="format-list" role="list" aria-label="密码解决方案功能列表">
				<div class="card" role="listitem">
					<LockIcon width="20" height="20" fill="currentColor" />
					本地密码本自动匹配
				</div>
				<div class="card" role="listitem">
					<BoxIcon width="20" height="20" fill="currentColor" />
					可扩展的远程密码源
				</div>
				<div class="card" role="listitem">
					<CheckmarkIcon width="20" height="20" fill="currentColor" />
					自动匹配并解压
				</div>
				<div class="card" role="listitem">
					<CheckmarkIcon width="20" height="20" fill="currentColor" />
					密码分享
				</div>
			</div>
		</PageSection>

		<PageSection header="现代化界面">
			<Fragment slot="description">
				<p class="subtitle">
					将官方版本中遗留的 Win32 对话框逐步迁移到 XAML，风格统一并支持
					Windows 11 新版右键菜单、Mica 材质与深色模式。
				</p>
				<p class="subtitle">
					压缩、解压、设置、文件选择器、分割文件、密码、替换、基准测试等
					界面全部现代化；信息与属性对话框做了高度自适应、字段对齐与
					每显示器 DPI 修正。
				</p>
			</Fragment>

			<ThemedLocalPicture
				class="image-card"
				lightSrc={contextMenuLight}
				darkSrc={contextMenuDark}
				alt=""
				loading="lazy"
			/>
		</PageSection>

		<PageSection header="智能解压">
			<Fragment slot="description">
				<p class="subtitle">
					智能解压：根目录只有单个条目的压缩包直接解压，多个根条目的自动
					放入新建文件夹，省去多余点击。
				</p>
				<p class="subtitle">
					本定制版还支持批量 / 单个循环解压、批量删除等批量操作优化。
				</p>
			</Fragment>

			<div class="se-demo-scenario" role="img" aria-label="智能解压演示：根目录只有单个文件或单个文件夹的压缩包直接解压；包含多个根条目的压缩包会将内容放入新建文件夹。">
				<div class="card" aria-hidden="true">
					<Tree text="Archive1.zip">
						<ArchiveFile width="20" height="20" slot="icon" />

						<Tree text="Music.mp3">
							<FileIcon fill="currentColor" slot="icon" />
						</Tree>
					</Tree>

					<Tree text="Archive2.zip">
						<ArchiveFile width="20" height="20" slot="icon" />

						<Tree text="Image.jpg">
							<FileIcon fill="currentColor" slot="icon" />
						</Tree>

						<Tree text="Document.docx">
							<FileIcon fill="currentColor" slot="icon" />
						</Tree>
					</Tree>
				</div>

				<RightArrow fill="currentColor" id="right-arrow" />

				<div class="card" aria-hidden="true">
					<Tree text="Music.mp3">
						<FileIcon fill="currentColor" slot="icon" />
					</Tree>

					<Tree text="Archive2">
						<FolderIcon fill="currentColor" slot="icon" />

						<Tree text="Image.jpg">
							<FileIcon fill="currentColor" slot="icon" />
						</Tree>

						<Tree text="Document.docx">
							<FileIcon fill="currentColor" slot="icon" />
						</Tree>
					</Tree>
				</div>
			</div>
		</PageSection>

		<PageSection header="文件格式">
			<p slot="description" class="subtitle">
				在 7-Zip 支持的基础上，额外支持 Zstandard、WASM、Electron ASAR、
				.NET 单文件等格式。
			</p>

			<div class="format-list" role="list" aria-label="NanaZip 额外支持的格式列表">
				<div class="card" role="listitem">Brotli</div>
				<div class="card" role="listitem">Lizard</div>
				<div class="card" role="listitem">LZ4</div>
				<div class="card" role="listitem">LZ5</div>
				<div class="card" role="listitem">Zstandard</div>
				<div class="card" role="listitem">Fast-LZMA2</div>
				<div class="card" role="listitem">NSIS</div>
				<div class="card" role="listitem">UFS</div>
				<div class="card" role="listitem">UFS2</div>
				<div class="card" role="listitem">.NET 单文件</div>
				<div class="card" role="listitem">Electron ASAR</div>
				<div class="card" role="listitem">ROMFS</div>
				<div class="card" role="listitem">ZealFS</div>
				<div class="card" role="listitem">WASM</div>
				<div class="card" role="listitem">CB7</div>
				<div class="card" role="listitem">CBZ</div>
				<div class="card" role="listitem">CBR</div>
			</div>
		</PageSection>

		<PageSection header="安全">
			<Fragment slot="description">
				<p class="subtitle">
					内置多项安全缓解措施，默认启用，可通过
					<a href="https://github.com/H-i-m-s/Better-NanaZip/blob/master/Documents/Policies.md">
						组策略
					</a>
					配置。
				</p>
			</Fragment>

			<div class="format-list" role="list" aria-label="NanaZip 内置的安全缓解措施">
				<div class="card" role="listitem">
					<ShieldIcon width="20" height="20" fill="currentColor" />
					Control Flow Guard
				</div>
				<div class="card" role="listitem">
					<ShieldIcon width="20" height="20" fill="currentColor" />
					影子栈（Shadow Stack）
				</div>
				<div class="card" role="listitem" style="width: max-content">
					<ShieldIcon width="20" height="20" fill="currentColor" />
					禁用动态代码生成
				</div>
				<div class="card" role="listitem">
					<ShieldIcon width="20" height="20" fill="currentColor" />
					包完整性校验
				</div>
				<div class="card" role="listitem">
					<ShieldIcon width="20" height="20" fill="currentColor" />
					Mark-Of-The-Web
				</div>
			</div>
		</PageSection>
	</main>
</Layout>
