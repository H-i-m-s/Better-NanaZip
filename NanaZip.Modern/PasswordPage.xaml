<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanaZip.Modern.PasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="OnPageKeyDown"
    PreviewKeyDown="OnPageKeyDown"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="12,12,12,12">
        <Grid.RowDefinitions>
            <!-- The content row is stretched: it absorbs sub-pixel height
                 changes of the controls (e.g. VisualState changes when the
                 check box is clicked), so the button row below never moves.
                 The window height is sized to the measured content (plus a
                 tiny margin), so the stretch row has almost no extra space
                 and the dialog stays compact. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                x:Name="PasswordText"
                VerticalAlignment="Center"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox
                    x:Name="PasswordInput"
                    Grid.Column="0"
                    Background="{ThemeResource TextControlBackground}"
                    Foreground="{ThemeResource TextControlForeground}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="{ThemeResource TextControlBorderThemeThickness}"
                    MinWidth="240"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    MaxLength="511"
                    KeyDown="OnPasswordKeyDown"
                    PasswordChanged="OnPasswordChanged"/>
                <Button
                    x:Name="AddPasswordButton"
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    VerticalAlignment="Stretch"
                    Click="OnAddPasswordClicked">
                    <FontIcon
                        x:Name="AddPasswordGlyph"
                        Glyph="&#xE710;"
                        FontSize="14"/>
                </Button>
            </Grid>
            <!-- Cloud / local password lookup buttons: UI only for now, the
                 handlers are placeholders (same as the extract dialog). -->
            <StackPanel
                x:Name="PasswordButtonsPanel"
                Orientation="Horizontal"
                Margin="0,10,0,0">
                <Button
                    x:Name="CloudPasswordButton"
                    Click="OnCloudPasswordClicked"/>
                <Button
                    x:Name="LocalPasswordButton"
                    Margin="6,0,0,0"
                    Click="OnLocalPasswordClicked"/>
            </StackPanel>
            <!-- Inline local-match result (no nested modal window; theme
                 font size and colors are inherited from the dialog). -->
            <TextBlock
                x:Name="MatchStatusText"
                Margin="0,8,0,0"
                TextWrapping="Wrap"
                Visibility="Collapsed"/>
            <CheckBox
                x:Name="SharePasswordCheck"
                Margin="0,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="OnSharePasswordClicked"/>
            <CheckBox
                x:Name="ShowPasswordCheck"
                Margin="0,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="OnShowPasswordClicked"/>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,6,0,0">
            <Button
                x:Name="OkButton"
                MinWidth="88"
                Margin="0,0,6,0"
                Click="OnOkClicked"/>
            <Button
                x:Name="CancelButton"
                MinWidth="88"
                Click="OnCancelClicked"/>
        </StackPanel>
    </Grid>
</Page>
