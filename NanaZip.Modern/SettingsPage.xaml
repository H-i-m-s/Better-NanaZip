<Page
  x:Class="NanaZip.Modern.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:NanaZip.Modern"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  IsTextScaleFactorEnabled="False"
  mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Tab bar (mimics the Win32 property sheet tabs) -->
    <StackPanel
      x:Name="TabBar"
      Grid.Row="0"
      Padding="12,8,12,0"
      Orientation="Horizontal">
      <ToggleButton
        x:Name="TabMenuButton"
        Margin="0,0,4,0"
        Padding="12,4"
        Click="TabButtonClick"
        IsChecked="False" />
      <ToggleButton
        x:Name="TabFoldersButton"
        Margin="0,0,4,0"
        Padding="12,4"
        Click="TabButtonClick"
        IsChecked="False" />
      <ToggleButton
        x:Name="TabEditorButton"
        Margin="0,0,4,0"
        Padding="12,4"
        Click="TabButtonClick"
        IsChecked="False" />
      <ToggleButton
        x:Name="TabSettingsButton"
        Margin="0,0,4,0"
        Padding="12,4"
        Click="TabButtonClick"
        IsChecked="False" />
      <ToggleButton
        x:Name="TabExtractButton"
        Margin="0,0,4,0"
        Padding="12,4"
        Click="TabButtonClick"
        IsChecked="False" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Border
        BorderBrush="{ThemeResource CardStrokeColorDefault}"
        BorderThickness="0,1,0,0" />

      <!-- ============ Integration (menu) page ============ -->
      <ScrollViewer
        x:Name="ContentMenu"
        Visibility="Collapsed"
        ScrollViewer.VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,12,16,12">
          <Button
            x:Name="MenuAssociateButton"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Click="MenuAssociateButtonClick" />
          <CheckBox
            x:Name="MenuElimDupCheck"
            Margin="0,12,0,0"
            Click="MenuCheckBoxClick" />
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Name="MenuZoneLabel"
              VerticalAlignment="Center"
              TextWrapping="Wrap" />
            <ComboBox
              x:Name="MenuZoneCombo"
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              SelectionChanged="MenuZoneComboChanged" />
          </Grid>
          <TextBlock
            x:Name="MenuContextItemsLabel"
            Margin="0,16,0,6"
            FontWeight="SemiBold" />
          <StackPanel x:Name="MenuContextListPanel" />
          <CheckBox
            x:Name="MenuExtractOnOpenCheck"
            Margin="0,10,0,0"
            Click="MenuCheckBoxClick" />
        </StackPanel>
      </ScrollViewer>

      <!-- ============ Folders page ============ -->
      <ScrollViewer
        x:Name="ContentFolders"
        Visibility="Collapsed"
        ScrollViewer.VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,12,16,12">
          <TextBlock
            x:Name="FoldersWorkFolderLabel"
            FontWeight="SemiBold" />
          <RadioButton
            x:Name="WorkModeSystemRadio"
            Margin="0,10,0,0"
            GroupName="WorkModeGroup"
            Click="WorkModeRadioClick" />
          <RadioButton
            x:Name="WorkModeCurrentRadio"
            GroupName="WorkModeGroup"
            Click="WorkModeRadioClick" />
          <RadioButton
            x:Name="WorkModeSpecifiedRadio"
            GroupName="WorkModeGroup"
            Click="WorkModeRadioClick" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="WorkPathTextBox"
              VerticalAlignment="Center"
              TextChanged="WorkPathTextChanged" />
            <Button
              x:Name="WorkPathBrowseButton"
              Grid.Column="1"
              Margin="6,0,0,0"
              MinWidth="36"
              Click="WorkPathBrowseButtonClick"
              Content="..." />
          </Grid>
          <CheckBox
            x:Name="ForRemovableOnlyCheck"
            Margin="0,12,0,0"
            Click="FoldersCheckBoxClick" />
        </StackPanel>
      </ScrollViewer>

      <!-- ============ Editor page ============ -->
      <ScrollViewer
        x:Name="ContentEditor"
        Visibility="Collapsed"
        ScrollViewer.VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,12,16,12">
          <TextBlock
            x:Name="EditorViewerLabel"
            FontWeight="SemiBold" />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="EditorViewerTextBox"
              VerticalAlignment="Center"
              TextChanged="EditorPathTextChanged" />
            <Button
              x:Name="EditorViewerBrowseButton"
              Grid.Column="1"
              Margin="6,0,0,0"
              MinWidth="36"
              Click="EditorBrowseButtonClick"
              Content="..." />
          </Grid>
          <TextBlock
            x:Name="EditorEditorLabel"
            Margin="0,14,0,0"
            FontWeight="SemiBold" />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="EditorEditorTextBox"
              VerticalAlignment="Center"
              TextChanged="EditorPathTextChanged" />
            <Button
              x:Name="EditorEditorBrowseButton"
              Grid.Column="1"
              Margin="6,0,0,0"
              MinWidth="36"
              Click="EditorBrowseButtonClick"
              Content="..." />
          </Grid>
          <TextBlock
            x:Name="EditorDiffLabel"
            Margin="0,14,0,0"
            FontWeight="SemiBold" />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="EditorDiffTextBox"
              VerticalAlignment="Center"
              TextChanged="EditorPathTextChanged" />
            <Button
              x:Name="EditorDiffBrowseButton"
              Grid.Column="1"
              Margin="6,0,0,0"
              MinWidth="36"
              Click="EditorBrowseButtonClick"
              Content="..." />
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- ============ Settings page ============ -->
      <ScrollViewer
        x:Name="ContentSettings"
        Visibility="Visible"
        ScrollViewer.VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,12,16,12">
          <CheckBox
            x:Name="SettingsShowDotsCheck"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsShowRealFileIconsCheck"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsFullRowCheck"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsShowGridCheck"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsSingleClickCheck"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsAlternativeSelectionCheck"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsShowSystemMenuCheck"
            Margin="0,14,0,0"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsLargePagesCheck"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsArcHistoryCheck"
            Margin="0,14,0,0"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsPathHistoryCheck"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsCopyHistoryCheck"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsFolderHistoryCheck"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsLowercaseHashesCheck"
            Click="SettingsCheckBoxClick" />
          <CheckBox
            x:Name="SettingsSizeFormatCheck"
            Margin="0,14,0,0"
            Click="SettingsCheckBoxClick" />

          <TextBlock
            x:Name="SettingsFontGroupLabel"
            Margin="0,16,0,6"
            FontWeight="SemiBold" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
              x:Name="FontAddressBarLabel"
              VerticalAlignment="Center" />
            <ComboBox
              x:Name="FontAddressBarCombo"
              Grid.Column="1"
              Margin="0,2"
              SelectionChanged="FontComboChanged" />
            <TextBlock
              x:Name="FontListLabel"
              Grid.Row="1"
              VerticalAlignment="Center" />
            <ComboBox
              x:Name="FontListCombo"
              Grid.Row="1"
              Grid.Column="1"
              Margin="0,2"
              SelectionChanged="FontComboChanged" />
            <TextBlock
              x:Name="FontStatusBarLabel"
              Grid.Row="2"
              VerticalAlignment="Center" />
            <ComboBox
              x:Name="FontStatusBarCombo"
              Grid.Row="2"
              Grid.Column="1"
              Margin="0,2"
              SelectionChanged="FontComboChanged" />
            <TextBlock
              x:Name="FontDialogLabel"
              Grid.Row="3"
              VerticalAlignment="Center" />
            <ComboBox
              x:Name="FontDialogCombo"
              Grid.Row="3"
              Grid.Column="1"
              Margin="0,2"
              SelectionChanged="FontDialogComboChanged" />
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- ============ Extract settings page ============ -->
      <ScrollViewer
        x:Name="ContentExtract"
        Visibility="Collapsed"
        ScrollViewer.VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,12,16,12">
          <CheckBox
            x:Name="ExtractDeleteAfterCheck"
            Click="ExtractCheckBoxClick" />
          <CheckBox
            x:Name="ExtractDeletePermanentlyCheck"
            Click="ExtractCheckBoxClick" />

          <TextBlock
            x:Name="ExtractAutoMatchGroupLabel"
            Margin="0,16,0,6"
            FontWeight="SemiBold" />
          <CheckBox
            x:Name="ExtractAutoQueryCloudCheck"
            Click="ExtractCheckBoxClick" />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ExtractApiUrlLabel" VerticalAlignment="Center" />
            <TextBox x:Name="ExtractApiUrlBox" Grid.Column="1" Margin="0,2" TextChanged="ExtractApiTextChanged" />
            <TextBlock x:Name="ExtractApiAppIdLabel" Grid.Row="1" VerticalAlignment="Center" />
            <TextBox x:Name="ExtractApiAppIdBox" Grid.Row="1" Grid.Column="1" Margin="0,2" TextChanged="ExtractApiTextChanged" />
            <TextBlock x:Name="ExtractApiAesKeyLabel" Grid.Row="2" VerticalAlignment="Center" />
            <TextBox x:Name="ExtractApiAesKeyBox" Grid.Row="2" Grid.Column="1" Margin="0,2" TextChanged="ExtractApiTextChanged" />
            <TextBlock x:Name="ExtractApiSigningKeyLabel" Grid.Row="3" VerticalAlignment="Center" />
            <TextBox x:Name="ExtractApiSigningKeyBox" Grid.Row="3" Grid.Column="1" Margin="0,2" TextChanged="ExtractApiTextChanged" />
            <TextBlock x:Name="ExtractApiPackageLabel" Grid.Row="4" VerticalAlignment="Center" />
            <TextBox x:Name="ExtractApiPackageBox" Grid.Row="4" Grid.Column="1" Margin="0,2" TextChanged="ExtractApiTextChanged" />
            <TextBlock x:Name="ExtractApiFingerprintLabel" Grid.Row="5" VerticalAlignment="Center" />
            <TextBox x:Name="ExtractApiFingerprintBox" Grid.Row="5" Grid.Column="1" Margin="0,2" TextChanged="ExtractApiTextChanged" />
          </Grid>
          <CheckBox
            x:Name="ExtractAutoMatchLocalCheck"
            Margin="0,10,0,0"
            Click="ExtractCheckBoxClick" />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Name="ExtractMatchPriorityLabel"
              VerticalAlignment="Center" />
            <ComboBox
              x:Name="ExtractMatchPriorityCombo"
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              SelectionChanged="ExtractMatchPriorityChanged" />
          </Grid>
          <CheckBox
            x:Name="ExtractAutoShowPasswordCheck"
            Margin="0,10,0,0"
            Click="ExtractCheckBoxClick" />

          <TextBlock
            x:Name="ExtractBookGroupLabel"
            Margin="0,16,0,6"
            FontWeight="SemiBold" />
          <TextBox
            x:Name="ExtractPasswordBookBox"
            MinHeight="120"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextChanged="ExtractBookTextChanged" />
          <Button
            x:Name="ExtractImportBookButton"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            Click="ExtractImportBookClick" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Bottom buttons -->
    <Grid
      Grid.Row="2"
      Padding="12,12,12,12"
      BorderBrush="{ThemeResource CardStrokeColorDefault}"
      BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button
          x:Name="ApplyButton"
          Width="110"
          Margin="4,0"
          Click="ApplyButtonClick" />
        <Button
          x:Name="OkButton"
          Width="110"
          Margin="4,0"
          Click="OkButtonClick" />
        <Button
          x:Name="CancelButton"
          Width="110"
          Margin="4,0"
          Click="CancelButtonClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
