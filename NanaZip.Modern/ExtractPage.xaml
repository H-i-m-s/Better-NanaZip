<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanaZip.Modern.ExtractPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="OnPageKeyDown"
    PreviewKeyDown="OnPageKeyDown"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="WrapCheckTextTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate>
        <DataTemplate x:Key="WrapComboItemTemplate">
            <TextBlock
                Text="{Binding}"
                TextWrapping="Wrap"
                MaxWidth="320"/>
        </DataTemplate>
        <DataTemplate x:Key="PathComboItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"/>
                <Button
                    Grid.Column="1"
                    Content="&#x2715;"
                    Click="OnDeleteHistoryPathClicked"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="12,12,12,12">
        <Grid.RowDefinitions>
            <!-- The content row shrinks when the user compresses the window;
                 the button row stays at its natural height so OK/Cancel are
                 never clipped. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <StackPanel x:Name="LeftColumnPanel" Grid.Column="0" Margin="0,0,12,0">
                <TextBlock
                    x:Name="ExtractToText"
                    TextWrapping="Wrap"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="PathCombo"
                        Grid.Column="0"
                        IsEditable="True"
                        MinWidth="120"
                        HorizontalAlignment="Stretch"
                        ItemTemplate="{StaticResource PathComboItemTemplate}"/>
                    <Button
                        x:Name="BrowseButton"
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        Content="..."
                        Click="OnBrowseClicked"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="NameEnableCheck"
                        Grid.Column="0"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        Click="OnNameEnableClicked"/>
                    <TextBox
                        x:Name="NameBox"
                        Grid.Column="1"
                        MinWidth="120"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Path mode: the label keeps one line; when the window is
                     squeezed too narrow, the combo moves to the next row
                     (handled in UpdateModeRowLayout). -->
                <Grid x:Name="PathModeRow" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PathModeText"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="28,0,0,0"
                        VerticalAlignment="Center"/>
                    <ComboBox
                        x:Name="PathModeCombo"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        MinWidth="140"
                        HorizontalAlignment="Stretch"
                        ItemTemplate="{StaticResource WrapComboItemTemplate}"/>
                </Grid>

                <CheckBox
                    x:Name="ElimDupCheck"
                    Margin="0,10,0,0"
                    ContentTemplate="{StaticResource WrapCheckTextTemplate}"
                    Click="OnElimDupClicked"/>

                <!-- Overwrite mode: same label/combo wrap behavior. -->
                <Grid x:Name="OverwriteModeRow" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="OverwriteModeText"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="28,0,0,0"
                        VerticalAlignment="Center"/>
                    <ComboBox
                        x:Name="OverwriteModeCombo"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        MinWidth="160"
                        HorizontalAlignment="Stretch"
                        ItemTemplate="{StaticResource WrapComboItemTemplate}"/>
                </Grid>
            </StackPanel>

            <!-- Right column -->
            <StackPanel x:Name="RightColumnPanel" Grid.Column="1" Margin="12,0,0,0">
                <Border
                    BorderBrush="#80808080"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="PasswordGroupText"/>
                        <PasswordBox
                            x:Name="PasswordBox"
                            Margin="0,6,0,0"/>
                        <!-- Cloud / local password lookup buttons: UI only
                             for now, the handlers are placeholders. -->
                        <StackPanel x:Name="PasswordButtonsPanel" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button
                                x:Name="CloudPasswordButton"
                                Content="查询云端密码"
                                Click="OnCloudPasswordClicked"/>
                            <Button
                                x:Name="LocalPasswordButton"
                                Content="匹配本地密码"
                                Margin="6,0,0,0"
                                Click="OnLocalPasswordClicked"/>
                        </StackPanel>
                        <CheckBox
                            x:Name="ShowPasswordCheck"
                            Margin="0,8,0,0"
                            ContentTemplate="{StaticResource WrapCheckTextTemplate}"
                            Click="OnShowPasswordClicked"/>
                    </StackPanel>
                </Border>

                <CheckBox
                    x:Name="NtSecurityCheck"
                    Margin="8,10,0,0"
                    ContentTemplate="{StaticResource WrapCheckTextTemplate}"
                    Click="OnNtSecurityClicked"/>

                <CheckBox
                    x:Name="OpenFolderCheck"
                    Margin="8,6,0,0"
                    ContentTemplate="{StaticResource WrapCheckTextTemplate}"
                    Click="OnOpenFolderClicked"/>

                <CheckBox
                    x:Name="DeleteAfterCheck"
                    Margin="8,6,0,0"
                    ContentTemplate="{StaticResource WrapCheckTextTemplate}"
                    Click="OnDeleteAfterClicked"/>
            </StackPanel>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,12,0,0">
            <Button
                x:Name="OkButton"
                MinWidth="88"
                Margin="0,0,6,0"
                Click="OnOkClicked"/>
            <Button
                x:Name="CancelButton"
                MinWidth="88"
                Click="OnCancelClicked"/>
        </StackPanel>
    </Grid>
</Page>
