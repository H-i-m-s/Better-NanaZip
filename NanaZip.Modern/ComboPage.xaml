<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanaZip.Modern.ComboPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="OnPageKeyDown"
    PreviewKeyDown="OnPageKeyDown"
    Background="Transparent">

    <Grid Padding="12,12,12,12">
        <Grid.RowDefinitions>
            <!-- The content row is stretched: it absorbs sub-pixel height
                 changes of the combo (e.g. VisualState changes when the
                 drop-down opens), so the button row below never moves.
                 The window height is sized to the measured content (plus a
                 tiny margin), so the stretch row has almost no extra space
                 and the dialog stays compact. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                x:Name="PromptText"
                VerticalAlignment="Center"/>
            <ComboBox
                x:Name="ValueCombo"
                Margin="0,8,0,0"
                IsEditable="True"
                MinWidth="240"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                KeyDown="OnComboKeyDown"/>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,6,0,0">
            <Button
                x:Name="OkButton"
                MinWidth="88"
                Margin="0,0,6,0"
                Click="OnOkClicked"/>
            <Button
                x:Name="CancelButton"
                MinWidth="88"
                Click="OnCancelClicked"/>
        </StackPanel>
    </Grid>
</Page>
