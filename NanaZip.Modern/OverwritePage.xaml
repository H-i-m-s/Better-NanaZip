<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanaZip.Modern.OverwritePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTextScaleFactorEnabled="False"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="12,10,12,12" MinHeight="0">
        <Grid.RowDefinitions>
            <!-- Match the verified dialog pattern used by Extract and
                 Compress: only the content row can scroll; the footer stays
                 in an independent Auto row. -->
            <RowDefinition Height="*" MinHeight="0"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            MinHeight="0"
            Padding="0,0,14,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="ContentPanel"
                Margin="0,0,0,8">
                <TextBlock
                    x:Name="HeaderText"
                    Margin="0,0,0,10"
                    TextWrapping="Wrap"/>
                <TextBlock
                    x:Name="QuestionBeginText"
                    Margin="0,0,0,6"
                    TextWrapping="Wrap"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image
                        x:Name="OldFileIcon"
                        Width="24"
                        Height="24"
                        Margin="0,4,4,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"/>
                    <TextBlock
                        x:Name="OldFileInfoText"
                        Grid.Column="1"
                        Margin="0,4,0,0"
                        TextWrapping="Wrap"/>
                </Grid>

                <TextBlock
                    x:Name="QuestionEndText"
                    Margin="0,0,0,6"
                    TextWrapping="Wrap"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image
                        x:Name="NewFileIcon"
                        Width="24"
                        Height="24"
                        Margin="0,4,4,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"/>
                    <TextBlock
                        x:Name="NewFileInfoText"
                        Grid.Column="1"
                        Margin="0,4,0,0"
                        TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid
            x:Name="FooterPanel"
            Grid.Row="1"
            Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefault}"
            BorderThickness="0,1,0,0"
            Padding="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel
                x:Name="ExtraButtonsRow"
                Grid.Row="0"
                MinHeight="36"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,0,0,6">
                <Button
                    x:Name="YesButton"
                    MinWidth="88"
                    MinHeight="36"
                    Padding="12,4"
                    Margin="0,0,6,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="OnYesClicked"/>
                <Button
                    x:Name="YesToAllButton"
                    MinWidth="88"
                    MinHeight="36"
                    Padding="12,4"
                    Margin="0,0,6,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="OnYesToAllClicked"/>
                <Button
                    x:Name="AutoRenameButton"
                    MinWidth="104"
                    MinHeight="36"
                    Padding="12,4"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="OnAutoRenameClicked"/>
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                MinHeight="36"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <Button
                    x:Name="NoButton"
                    MinWidth="88"
                    MinHeight="36"
                    Padding="12,4"
                    Margin="0,0,6,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="OnNoClicked"/>
                <Button
                    x:Name="NoToAllButton"
                    MinWidth="88"
                    MinHeight="36"
                    Padding="12,4"
                    Margin="0,0,6,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="OnNoToAllClicked"/>
                <Button
                    x:Name="CancelButton"
                    MinWidth="104"
                    MinHeight="36"
                    Padding="12,4"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="OnCancelClicked"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
