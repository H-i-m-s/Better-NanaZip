<?xml version="1.0" encoding="utf-8"?>
<!--
  PROJECT:    NanaZip
  FILE:       NanaZip.Modern.props
  PURPOSE:    MSBuild Properties for NanaZip.Modern

  LICENSE:    The MIT License

  MAINTAINER: MouriNaruto (Kenji.Mouri@outlook.com)
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IncludePath>$(MSBuildThisFileDirectory);$(IncludePath)</IncludePath>
  </PropertyGroup>
  <Target Name="NanaZipModernBuildSource" BeforeTargets="BeforeClCompile">
    <ItemGroup>
      <ClCompile Include="$(MSBuildThisFileDirectory)NanaZip.Modern.Wrapper.cpp" />
    </ItemGroup>
  </Target>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Marks the GUI builds that link the Modern wrapper (FileManager and
           Universal): the 7-Zip side uses this to route the password dialog
           to the XAML implementation instead of the Win32 CPasswordDialog.
           SFX / Classic do not import this props file, so they keep the
           Win32 dialog. -->
      <PreprocessorDefinitions>NANAZIP_MODERN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)NanaZip.Modern.vcxproj">
      <Project>{1AB11057-1F48-44D2-A913-C945BFC1AA93}</Project>
    </ProjectReference>
  </ItemGroup>
</Project>