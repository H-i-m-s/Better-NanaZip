<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NanaZip.Modern.CompressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="OnPageKeyDown"
    PreviewKeyDown="OnPageKeyDown"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="WrapItemTemplate">
            <TextBlock
                Text="{Binding}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis"
                MaxWidth="360" />
        </DataTemplate>
        <!-- Archive path drop-down item: path text plus a delete "x" that
             only appears while the drop-down is open (history removal). -->
        <DataTemplate x:Key="PathComboItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding}"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0" />
                <Button
                    Grid.Column="1"
                    Content="&#x2715;"
                    Click="OnDeleteHistoryPathClicked"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="12,12,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            Padding="0,0,14,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="LeftColumnPanel" Grid.Row="0" Grid.Column="0">
                    <TextBlock x:Name="ArchiveFolderText" TextWrapping="Wrap" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="ArchivePathCombo"
                            Grid.Column="0"
                            IsEditable="True"
                            MinWidth="140"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource PathComboItemTemplate}"
                            DropDownOpened="OnArchivePathDropDownOpened"
                            DropDownClosed="OnArchivePathDropDownClosed"
                            LostFocus="OnArchivePathChanged" />
                        <Button
                            x:Name="BrowseButton"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Content="..."
                            Click="OnBrowseClicked" />
                    </Grid>

                    <!-- 格式行：标签 + 下拉同行；窗口压窄时下拉换到下一行顶格（与左列所有行同步） -->
                    <Grid x:Name="FormatRow" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="FormatText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="FormatCombo"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            MinWidth="140"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource WrapItemTemplate}"
                            SelectionChanged="OnFormatChanged" />
                    </Grid>

                    <Grid x:Name="LevelRow" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="LevelText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="LevelCombo"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            MinWidth="140"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource WrapItemTemplate}"
                            SelectionChanged="OnLevelChanged" />
                    </Grid>

                    <Grid x:Name="MethodRow" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="MethodText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="MethodCombo"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            MinWidth="140"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource WrapItemTemplate}"
                            SelectionChanged="OnMethodChanged" />
                    </Grid>

                    <Grid x:Name="DictionaryRow" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="DictionaryText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="DictionaryCombo"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            MinWidth="140"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource WrapItemTemplate}"
                            SelectionChanged="OnDictionaryChanged" />
                    </Grid>

                    <Grid x:Name="OrderRow" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="OrderText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="OrderCombo"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            MinWidth="140"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource WrapItemTemplate}"
                            SelectionChanged="OnOrderChanged" />
                    </Grid>

                    <Grid x:Name="SolidRow" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="SolidText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="SolidCombo"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            MinWidth="140"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource WrapItemTemplate}"
                            SelectionChanged="OnSolidChanged" />
                    </Grid>

                    <Grid x:Name="ThreadsRow" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ThreadsText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="ThreadsCombo"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            MinWidth="140"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource WrapItemTemplate}"
                            SelectionChanged="OnThreadsChanged" />
                    </Grid>
                    <TextBlock x:Name="HardwareThreadsText" Opacity="0.8" TextWrapping="Wrap" />

                    <Grid x:Name="MemoryRow" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="MemoryText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="MemoryCombo"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            MinWidth="140"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource WrapItemTemplate}"
                            SelectionChanged="OnMemoryChanged" />
                        <TextBlock
                            x:Name="MemoryValueText"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,4,0,0"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid x:Name="VolumeRow" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="VolumeText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="VolumeCombo"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            MinWidth="140"
                            HorizontalAlignment="Stretch"
                            IsEditable="True"
                            ItemTemplate="{StaticResource WrapItemTemplate}"
                            LostFocus="OnVolumeChanged" />
                    </Grid>

                    <Grid x:Name="ParametersRow" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ParametersText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                        <TextBox
                            x:Name="ParametersBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="36"
                            TextChanged="OnParametersChanged" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="OptionsButton"
                            Content="Options"
                            Click="OnOptionsClicked" />
                        <TextBlock
                            x:Name="OptionsSummaryText"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="RightColumnPanel" Grid.Row="0" Grid.Column="2">
                    <Grid x:Name="UpdateModeRow">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="UpdateModeText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="UpdateModeCombo"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            MinWidth="140"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource WrapItemTemplate}"
                            SelectionChanged="OnUpdateModeChanged" />
                    </Grid>

                    <Grid x:Name="PathModeRow" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PathModeText"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="PathModeCombo"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            MinWidth="140"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource WrapItemTemplate}"
                            SelectionChanged="OnPathModeChanged" />
                    </Grid>

                    <Border
                        x:Name="OptionsBorder"
                        Margin="0,12,0,0"
                        BorderBrush="#80808080"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="8">
                        <StackPanel>
                            <TextBlock x:Name="OptionsGroupText" TextWrapping="Wrap" />
                            <CheckBox
                                x:Name="SfxCheck"
                                Margin="0,8,0,0"
                                ContentTemplate="{StaticResource WrapItemTemplate}"
                                Click="OnSfxClicked" />
                            <CheckBox
                                x:Name="SharedCheck"
                                Margin="0,6,0,0"
                                ContentTemplate="{StaticResource WrapItemTemplate}"
                                Click="OnSharedClicked" />
                            <CheckBox
                                x:Name="DeleteCheck"
                                Margin="0,6,0,0"
                                ContentTemplate="{StaticResource WrapItemTemplate}"
                                Click="OnDeleteClicked" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="EncryptionBorder"
                        Margin="0,12,0,0"
                        BorderBrush="#80808080"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="8">
                        <StackPanel>
                            <TextBlock x:Name="EncryptionGroupText" TextWrapping="Wrap" />
                            <TextBlock x:Name="PasswordText" Margin="0,8,0,0" />
                            <PasswordBox x:Name="PasswordBox" Margin="0,6,0,0" />
                            <TextBlock x:Name="ReenterPasswordText" Margin="0,8,0,0" />
                            <PasswordBox x:Name="ReenterPasswordBox" Margin="0,6,0,0" />
                            <CheckBox
                                x:Name="ShowPasswordCheck"
                                Margin="0,6,0,0"
                                ContentTemplate="{StaticResource WrapItemTemplate}"
                                Click="OnShowPasswordClicked" />
                            <!-- 加密算法行：标签与勾选框文本左对齐（Margin 28）；默认同行，窗口压得很窄时才换行 -->
                            <Grid x:Name="EncryptionMethodRow" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="EncryptionMethodText"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="28,0,0,0"
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    x:Name="EncryptionMethodCombo"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    MinWidth="140"
                                    HorizontalAlignment="Stretch"
                                    ItemTemplate="{StaticResource WrapItemTemplate}"
                                    SelectionChanged="OnEncryptionMethodChanged" />
                            </Grid>
                            <CheckBox
                                x:Name="EncryptHeadersCheck"
                                Margin="0,6,0,0"
                                ContentTemplate="{StaticResource WrapItemTemplate}"
                                Click="OnEncryptHeadersClicked" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock
                    x:Name="ErrorTextBlock"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,8,0,0"
                    Foreground="#FFE06C75"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,12,0,0">
            <Button
                x:Name="OkButton"
                MinWidth="88"
                Margin="0,0,8,0"
                Content="OK"
                Click="OnOkClicked" />
            <Button
                x:Name="CancelButton"
                MinWidth="88"
                Content="Cancel"
                Click="OnCancelClicked" />
        </StackPanel>
    </Grid>
</Page>
